--=====================================================================
--  FLEX UGC CODES :: PLAYTIME COIN FARMER
--  Milestones: 10 / 20 / 30 min. Race the payout, don't wait politely.
--=====================================================================
if not game:IsLoaded() then game.Loaded:Wait() end
local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local UIS     = game:GetService("UserInputService")
local LP      = Players.LocalPlayer

local CFG = {
    Milestones = { 600, 1200, 1800 },
    RaceCount  = 25,     -- fires per burst (all in one frame)
    DripCount  = 15,     -- slow fallback bursts
    DripDelay  = 0.4,
}

local BALANCE  = nil
local LAST_BAL = 0
local CLAIMS   = {}      -- captured claim remote(s) + args
local ARMED    = false
local AUTO     = true    -- auto-race at milestones
local SESSION  = os.clock()

local FUZZ = {
    {1},{2},{3},{10},{20},{30},{600},{1200},{1800},
    {"10"},{"20"},{"30"},{"minute"},{"reward"},{true},
}

local function fire(r, args)
    pcall(function()
        if r:IsA("RemoteFunction") then
            r:InvokeServer(table.unpack(args or {}))
        else
            r:FireServer(table.unpack(args or {}))
        end
    end)
end

---------------------------------------------------------------------
-- capture
---------------------------------------------------------------------
local function arm()
    if ARMED then return end
    ARMED = true
    local old
    old = hookmetamethod(game, "__namecall", function(self, ...)
        local m = getnamecallmethod()
        if (m == "FireServer" or m == "InvokeServer")
           and typeof(self) == "Instance"
           and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then
            local args = { ... }
            local known = false
            for _, c in ipairs(CLAIMS) do if c.r == self then known = true end end
            if not known then
                table.insert(CLAIMS, { r = self, args = args })
                print(("[Playtime] captured %s(%d args)"):format(self:GetFullName(), #args))
            end
        end
        return old(self, ...)
    end)
    print("[Playtime] hook armed")
end

---------------------------------------------------------------------
-- balance watch
---------------------------------------------------------------------
local function findBalance()
    for _, root in ipairs({ LP, LP:FindFirstChild("leaderstats"), RS }) do
        if root then
            local ok, list = pcall(function() return root:GetDescendants() end)
            if ok then
                for _, o in ipairs(list) do
                    if o:IsA("ValueBase") and typeof(o.Value) == "number" then
                        local n = string.lower(o.Name)
                        if string.find(n,"coin",1,true) or string.find(n,"balance",1,true)
                           or string.find(n,"cash",1,true) then
                            return o
                        end
                    end
                end
            end
        end
    end
end

local function watch()
    BALANCE = findBalance()
    if not BALANCE then return false end
    LAST_BAL = BALANCE.Value
    BALANCE.Changed:Connect(function(v)
        if typeof(v) ~= "number" then return end
        local d = v - LAST_BAL
        LAST_BAL = v
        if d > 0 then
            print(("[Playtime] +%d coins (total %d)"):format(d, v))
            if AUTO and #CLAIMS > 0 then
                -- a grant landed: immediately try to stack more on top of it
                task.delay(0.15, function() burst() end)
            end
        end
    end)
    print("[Playtime] balance locked: " .. BALANCE:GetFullName())
    return true
end

---------------------------------------------------------------------
-- race
---------------------------------------------------------------------
local function burst()
    if #CLAIMS == 0 then print("[Playtime] nothing captured yet"); return end
    for _, c in ipairs(CLAIMS) do
        if c.r:IsA("RemoteFunction") then
            for _ = 1, CFG.RaceCount do task.spawn(fire, c.r, c.args) end
        else
            for _ = 1, CFG.RaceCount do fire(c.r, c.args) end
        end
    end
    print(("[Playtime] burst x%d"):format(CFG.RaceCount))
end

local function drip()
    if #CLAIMS == 0 then print("[Playtime] nothing captured yet"); return end
    task.spawn(function()
        for _ = 1, CFG.DripCount do
            for _, c in ipairs(CLAIMS) do fire(c.r, c.args) end
            task.wait(CFG.DripDelay)
        end
        print("[Playtime] drip done")
    end)
end

local function fuzz()
    if #CLAIMS == 0 then print("[Playtime] capture a claim first"); return end
    task.spawn(function()
        for _, shape in ipairs(FUZZ) do
            for _, c in ipairs(CLAIMS) do fire(c.r, shape) end
            task.wait(0.15)
        end
        print("[Playtime] arg fuzz done")
    end)
end

---------------------------------------------------------------------
-- milestone clock + anti-afk
---------------------------------------------------------------------
task.spawn(function()
    local nextIdx = 1
    while true do
        task.wait(1)
        local el = os.clock() - SESSION
        if nextIdx <= #CFG.Milestones and el >= CFG.Milestones[nextIdx] then
            local m = CFG.Milestones[nextIdx] / 60
            nextIdx = nextIdx + 1
            print(("[Playtime] %d min reached"):format(m))
            if AUTO and #CLAIMS > 0 then burst() end
        end
    end
end)

